{
  "Urls": "http://localhost:8088",
  "Storage": {
    "Provider": "Sqlite",
    "DatabasePath": "data/rockets.db",
    "Synchronous": "Full"
  },
  "Ingestion": {
    "QueueCapacity": 1024,
    "MaxBatchSize": 256,
    "EnqueueTimeout": "00:00:05"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
